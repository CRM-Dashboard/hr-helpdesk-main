# Host the CRM / helpdesk backend is served from. The helpdesk API is mounted
# at "<host>/api/helpdesk". Defaults to http://localhost:5000 when unset.
VITE_API_BASE_URL=http://localhost:5000

# INTERIM: the address sent as `x-user-email` while the helpdesk backend runs in
# header auth mode. Falls back to manish.pandey@gera.in. Goes away when the host
# shell hands us a JWT (HELPDESK_AUTH_MODE=jwt server-side).
VITE_HELPDESK_USER_EMAIL=manish.pandey@gera.in
